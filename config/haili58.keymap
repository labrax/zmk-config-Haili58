#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp ESC           &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp NUMBER_5        &kp NUMBER_6    &kp N7  &kp N8     &kp N9     &kp N0     &kp MINUS
&kp TAB           &kp Q         &kp W         &kp E         &kp R         &kp T               &kp Y           &kp U   &kp I      &kp O      &kp P      &kp BACKSPACE
&kp LEFT_CONTROL  &kp A         &kp S         &kp D         &kp F         &kp G               &kp H           &kp J   &kp K      &kp L      &kp GRAVE  &kp SINGLE_QUOTE
&kp LEFT_SHIFT    &kp Z         &kp X         &kp C         &kp V         &kp B               &kp N           &kp M   &kp COMMA  &kp DOT    &kp SLASH  &kp RMETA
&kp LEFT_ALT      &mo 1         &kp SPACE     &trans        &trans        &studio_unlock      &studio_unlock  &trans  &trans     &kp ENTER  &mo 1      &kp RIGHT_ALT
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp UP DOWN>;
        };

        layer_1 {
            bindings = <
&kp SEMICOLON  &kp F1  &kp F2  &kp F3  &kp F4             &kp F5                &kp F6       &kp F7         &kp F8          &kp F9           &kp F10               &kp F11
&trans         &trans  &trans  &trans  &kp K_PREVIOUS     &kp K_NEXT            &kp PAGE_UP  &kp PAGE_DOWN  &kp HOME        &kp END          &kp DEL               &kp F12
&trans         &kp F9  &kp F8  &trans  &kp K_VOLUME_DOWN  &kp K_VOLUME_UP       &kp LEFT     &kp DOWN       &kp UP_ARROW    &kp RIGHT        &kp LEFT_BRACKET      &kp RIGHT_BRACKET
&trans         &trans  &trans  &kp F7  &kp K_MUTE         &kp K_PLAY_PAUSE      &kp INSERT   &kp CAPSLOCK   &kp SCROLLLOCK  &kp PLUS         &kp NON_US_BACKSLASH  &kp NON_US_HASH
&trans         &trans  &trans  &trans  &trans             &trans                &trans       &trans         &trans          &kp PRINTSCREEN  &kp K_MENU            &trans
            >;
        };

        layer_2 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans      &trans   &trans           &trans       &trans         &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &kp INS  &kp HOME         &kp PAGE_UP  &kp PAGE_DOWN  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &kp END  &kp PRINTSCREEN  &trans       &trans         &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans   &trans           &trans       &trans         &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans   &trans           &trans       &trans         &trans  &trans
            >;
        };
    };
};
